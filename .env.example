# Confirmed public URL; trailing repository paths are supported if hosting changes.
VITE_SITE_URL=https://multiverse-benchmark.com/

# Leave blank until a GA4 Web data stream has been created.
# Analytics loads only on VITE_SITE_URL and only after a visitor opts in.
VITE_GA_MEASUREMENT_ID=

# Optional: Search Console URL-prefix property HTML verification token.
# A Domain property can instead be verified through DNS, without this token.
VITE_GOOGLE_SITE_VERIFICATION=
