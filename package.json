{
  "name": "multiverse-project-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:gui && npm run build:board && tsc --noEmit && vite build",
    "build:linked": "npm run build:gui && npm run build:board && tsc --noEmit && MV_LINK_PUBLIC=1 vite build && cp -al public/. dist/",
    "build:board": "python3 scripts/build_board.py",
    "preview": "vite preview",
    "validate:data": "python3 scripts/validate_export.py && python3 scripts/validate_export.py public/data/v1.1.0",
    "validate:leaderboard": "python3 scripts/export_leaderboard.py --validate-only",
    "validate:submissions": "python3 scripts/export_submission_reference.py --check && python3 scripts/build_board.py --check",
    "validate:runs": "python3 scripts/export_runs.py --validate-only",
    "test:runs": "node tests/runs.browser.mjs",
    "test:task-views": "node tests/task-views.browser.mjs",
    "test:leaderboard": "node tests/leaderboard-uncertainty.browser.mjs",
    "build:gui": "npm --prefix gui-src run build",
    "test:browser": "node tests/explorer.browser.mjs",
    "test:gui": "node tests/gui.browser.mjs",
    "test:gui:embedding": "node tests/gui.embedding.browser.mjs",
    "test:gui:storage": "node tests/gui-storage.browser.mjs",
    "test:gui:demo": "node tests/gui-demo.browser.mjs",
    "test:tools": "node tests/tools.browser.mjs",
    "validate:tools": "python3 scripts/export_tools.py --validate-only",
    "test:tools:wrap": "node tests/tools-wrap.browser.mjs",
    "validate:showcase": "python3 scripts/export_showcase.py --validate-only",
    "test:gui:records": "node tests/gui-records.browser.mjs",
    "test:calendar": "node --test tests/calendar-snapshot.test.mjs",
    "test:calendar:browser": "node tests/calendar-timezone.browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^5.4.21"
  }
}
