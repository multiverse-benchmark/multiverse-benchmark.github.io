[
  {
    "name": "make_call",
    "description": "Make a call to a single recipient with exactly one phone number endpoint.\n\nTo resolve the phone number endpoint, you may have to call one or more tools\nprior to calling this operation. Before calling this operation, always check\nif the Geofencing Policy applies. If there is a recipient with more than one\nphone number endpoints, ask the user for the intended endpoint by invoking\nshow_call_recipient_choices. Do not call this operation until the user has\nchosen a single recipient with exactly one phone number endpoint.\n\nWhen recipient is provided, the function validates that contact_name and\ncontact_endpoints belong to the same contact in the database.",
    "parameters": {
      "type": "object",
      "properties": {
        "recipient": {
          "description": "The recipient of the phone call. Defaults to None. Contains: contact_id, contact_name, contact_endpoints, contact_photo_url, recipient_type, address, distance, confidence_level.",
          "type": "object",
          "nullable": true,
          "default": null,
          "properties": {
            "contact_id": {
              "description": "Unique identifier for the contact",
              "type": "string",
              "nullable": true,
              "default": null
            },
            "contact_name": {
              "description": "Name of the contact",
              "type": "string",
              "nullable": true,
              "default": null
            },
            "contact_endpoints": {
              "description": "List of endpoints for the contact. Each endpoint represents a different phone number (e.g., mobile, work, home). Each endpoint dict contains:",
              "type": "array",
              "nullable": true,
              "default": null,
              "items": {
                "description": "Model for phone contact endpoint.",
                "type": "object",
                "nullable": false,
                "properties": {
                  "endpoint_type": {
                    "description": "Type of endpoint",
                    "type": "string",
                    "default": "PHONE_NUMBER",
                    "nullable": false
                  },
                  "endpoint_value": {
                    "description": "Endpoint value (phone number)",
                    "type": "string",
                    "nullable": false
                  },
                  "endpoint_label": {
                    "description": "Endpoint label",
                    "type": "string",
                    "nullable": true,
                    "default": null
                  },
                  "is_primary": {
                    "description": "Primary endpoint flag (legacy field from contacts DB).",
                    "type": "boolean",
                    "nullable": true,
                    "default": null
                  }
                },
                "required": [
                  "endpoint_value"
                ]
              }
            },
            "contact_photo_url": {
              "description": "URL to the contact's profile photo",
              "type": "string",
              "nullable": true,
              "default": null
            },
            "recipient_type": {
              "description": "Type of recipient (\"CONTACT\", \"BUSINESS\", \"DIRECT\", \"VOICEMAIL\").",
              "type": "string",
              "enum": [
                "CONTACT",
                "BUSINESS",
                "DIRECT",
                "VOICEMAIL"
              ],
              "nullable": true,
              "default": null
            },
            "address": {
              "description": "Address of the recipient",
              "type": "string",
              "nullable": true,
              "default": null
            },
            "distance": {
              "description": "Distance to the recipient",
              "type": "string",
              "nullable": true,
              "default": null
            },
            "confidence_level": {
              "description": "Confidence level of the recipient match.",
              "type": "string",
              "nullable": true,
              "default": null,
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          },
          "required": []
        },
        "on_speakerphone": {
          "description": "If True, the phone call will be placed on the speakerphone. Defaults to False.",
          "type": "boolean",
          "nullable": false,
          "default": false
        },
        "recipient_name": {
          "description": "The recipient's name. Defaults to None.",
          "type": "string",
          "nullable": true,
          "default": null
        },
        "recipient_phone_number": {
          "description": "The phone number of the recipient to make the call to, e.g. \"+11234567890\". This value is validated for proper format. Defaults to None.",
          "type": "string",
          "nullable": true,
          "default": null
        },
        "recipient_photo_url": {
          "description": "The url to the profile photo of the recipient. Defaults to None.",
          "type": "string",
          "nullable": true,
          "default": null
        }
      },
      "required": []
    }
  },
