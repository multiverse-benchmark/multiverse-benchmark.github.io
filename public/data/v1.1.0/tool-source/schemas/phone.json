  {
    "name": "show_call_recipient_choices",
    "description": "Show a list of one or more recipients to the user to choose from.\n\nThis operation uses a UI component to show the list of choices. You do not\nneed to enumerate the list of choices in your final response. If you call\nthis operation, you may not call other operations from this tool before\ndrafting the final response.\n\nThe function validates that contact_name and contact_endpoints belong to the same contact\nin the database to prevent mismatched data.\n\nInvoke this operation in the following scenarios:\n    * There are multiple recipients (contacts or businesses) to choose from.\n    * There are multiple phone number endpoints for a business to choose from.\n    * There are multiple phone number endpoints for a single contact to choose from.\n    * There is a single contact recipient with `confidence_level` LOW.\n    * The Geofencing Policy applies.",
    "parameters": {
      "type": "object",
      "properties": {
        "recipients": {
          "description": "A list of recipient objects to display as choices.",
          "type": "array",
          "minItems": 1,
          "nullable": false,
          "items": {
            "type": "object",
            "nullable": false,
            "properties": {
              "contact_id": {
                "description": "Unique identifier for the contact",
                "type": "string",
                "nullable": true,
                "default": null
              },
              "contact_name": {
                "description": "Name of the contact",
                "type": "string",
                "nullable": true,
                "default": null
              },
              "recipient_type": {
                "description": "Type of recipient (\"CONTACT\", \"BUSINESS\", \"DIRECT\", \"VOICEMAIL\").",
                "type": "string",
                "enum": [
                  "CONTACT",
                  "BUSINESS",
                  "DIRECT",
                  "VOICEMAIL"
                ],
                "nullable": true,
                "default": null
              },
              "address": {
                "description": "Address of the recipient",
                "type": "string",
                "nullable": true,
                "default": null
              },
              "distance": {
                "description": "Distance to the recipient",
                "type": "string",
                "nullable": true,
                "default": null
              },
              "contact_endpoints": {
                "description": "List of endpoints for the contact. Each endpoint represents a different phone number.",
                "type": "array",
                "nullable": false,
                "items": {
                  "description": "Model for phone contact endpoint.",
                  "type": "object",
                  "nullable": false,
                  "properties": {
                    "endpoint_type": {
                      "description": "Type of endpoint. Use \"PHONE_NUMBER\" or a legacy label (\"mobile\", \"work\", \"home\", \"main\", \"other\"); legacy values are normalized to PHONE_NUMBER.",
                      "type": "string",
                      "default": "PHONE_NUMBER",
                      "nullable": false
                    },
                    "endpoint_value": {
                      "description": "Endpoint value (phone number)",
                      "type": "string",
                      "nullable": false
                    },
                    "endpoint_label": {
                      "description": "Endpoint label",
                      "type": "string",
                      "nullable": true,
                      "default": null
                    },
                    "is_primary": {
                      "description": "Primary endpoint flag (legacy field from contacts DB).",
                      "type": "boolean",
                      "nullable": true,
                      "default": null
                    }
                  },
                  "required": [
                    "endpoint_value"
                  ]
                }
              },
              "contact_photo_url": {
                "description": "URL to the contact's profile photo",
                "type": "string",
                "nullable": true,
                "default": null
              },
              "confidence_level": {
                "description": "Confidence level of the recipient match.",
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ],
                "nullable": true,
                "default": null
              }
            },
            "required": [
              "contact_endpoints"
            ]
          }
        }
      },
      "required": [
        "recipients"
      ]
    }
  },
  {
    "name": "show_call_recipient_not_found_or_specified",
    "description": "Show a message to the user when the call recipient is not found or not specified.\n\nYou must attempt to search for a recipient before calling this operation.\nCall this operation when no match is found for a recipient, or when the user\nexpresses an intent to call without specifying a recipient.",
    "parameters": {
      "type": "object",
      "properties": {
        "contact_name": {
          "description": "The recipient name that was searched for. Defaults to None.",
          "type": "string",
          "nullable": true,
          "default": null
        }
      },
      "required": []
    }
  }
]